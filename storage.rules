rules_version = '2';
// Path wildcards must be whole segments: the old `match /profile_images/
// {uid}.jpg` does not compile ("mismatched input '.'"), so this file could
// never have been deployed as written — production Storage is running on
// whatever rules were last set in the Firebase console. Check them before
// deploying this.
//
// `write` is split into create/update vs delete on purpose: on a delete
// `request.resource` is null, so the size/contentType checks below would
// error out and deny the owner's own delete — which is what
// AccountDeletionService._purgeStoredFiles relies on to erase profile and
// comment images. Like firestore.rules, this file does nothing until
// `firebase deploy --only storage` is run.
service firebase.storage {
  match /b/{bucket}/o {
    // One file per user: profile_images/{uid}.jpg (EditProfileScreen).
    match /profile_images/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }
    match /comment_images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
