rules_version = '2';

// Draft security rules matching the current client-side data model (see
// lib/services/*.dart). NOT DEPLOYED — this file only takes effect once you
// run `firebase deploy --only firestore:rules`. Test it against the
// Firestore emulator / Rules Playground before relying on it in production;
// it has not been run against real traffic.
//
// General shape: everything under a user's own `users/{uid}` doc and its
// subcollections is owner-write, and either owner-read or "any signed-in
// user can read" depending on whether another screen in the app needs to
// read it (public profiles, friends' activity, search).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --------------------------------------------------------------- users --
    match /users/{userId} {
      // Public-ish profile: search, public profile screen, and friends'
      // activity all read other users' docs.
      allow read: if isSignedIn();
      allow create: if isOwner(userId);

      // SIMPLIFICATION: follow()/unfollow()/block() in SocialService write
      // directly to the *target* user's `followers` array from the client
      // (arrayUnion/arrayRemove), so this can't be a strict isOwner()-only
      // rule. This allows any signed-in user to modify ONLY the `followers`
      // field of any user doc — it does not verify the array only gained/
      // lost the requester's own uid. A follower-count-manipulation attack
      // is possible (low severity for this app) until follow/unfollow is
      // moved behind a Cloud Function that writes with the Admin SDK
      // (which bypasses these rules entirely). Tightening this is tracked
      // in plan.md.
      allow update: if isOwner(userId) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));
      // Lets SettingsScreen's account-deletion flow remove the profile doc.
      // Subcollections aren't cascade-deleted by this (Firestore doesn't do
      // that), so they're orphaned rather than purged — a full wipe needs a
      // Cloud Function with the Admin SDK.
      allow delete: if isOwner(userId);

      // Private per-user movie/show library. Read is opened up because
      // SocialService.userWatchedMovies/userFavoriteMovies/userShows read
      // another user's subcollection directly (public profile screen).
      match /movies/{movieId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /shows/{showId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);

        // Per-episode watched flags and private notes — never read
        // cross-user in the app, so owner-only both ways.
        match /watched/{episodeKey} {
          allow read, write: if isOwner(userId);
        }
        match /notes/{episodeKey} {
          allow read, write: if isOwner(userId);
        }
      }

      // Watch-history timeline. Read is public-to-signed-in because
      // SocialService.friendsActivity() reads followed users' activity.
      match /activity/{activityId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // Diary entries and custom lists are private — never read cross-user.
      match /diary/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /lists/{listId} {
        allow read, write: if isOwner(userId);
      }

      // This user's own answers to the post-watch "how was it?" poll —
      // never read cross-user (the aggregate in /polls covers that).
      match /pollAnswers/{pollId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------- polls --
    // Cross-user aggregate counts for the post-watch poll (PollService).
    // Anyone signed in can read (to show live percentages) and increment the
    // count/total fields (to cast a vote) — same manipulation caveat as the
    // `followers` field above: any signed-in user could inflate these for-fun
    // stats, which is an acceptable, low-severity tradeoff for this app.
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ratingCounts', 'ratingTotal',
          'platformCounts', 'platformTotal',
          'emotionCounts', 'emotionTotal',
          'characterCounts', 'characterTotal',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // ------------------------------------------------------------ comments --
    // Public UGC on titles (CommentService). Anyone signed in can read and
    // post; only the author can delete; likes are the one field anyone
    // signed in may toggle on someone else's comment.
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------- reports --
    // Moderation reports (CommentService.report()). Write-only from the
    // client; reviewing them is a moderator/admin-console job (the Admin
    // SDK bypasses these rules), so there is no client-facing read case.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
