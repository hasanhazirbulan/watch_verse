rules_version = '2';

// Security rules matching the current client-side data model (see
// lib/services/*.dart). Deployed to production as of 2026-07-26 (see
// plan.md) — this file has no effect on its own; every edit needs
// `firebase deploy --only firestore:rules` run again before it's live. A
// past edit here sat undeployed for weeks and was the actual root cause of
// a "can't vote on polls" bug — don't let that repeat.
//
// General shape: everything under a user's own `users/{uid}` doc and its
// subcollections is owner-write, and either owner-read or "any signed-in
// user can read" depending on whether another screen in the app needs to
// read it (public profiles, friends' activity, search).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // REMOVED 2026-10-04 (was isSelfOnlyArrayToggle — see `followers` and
    // `likes` rules below). Intent: let a signed-in user flip their own
    // membership in another doc's array field (follow/unfollow, comment
    // likes) without being able to touch anyone else's. Confirmed root
    // cause of a live unfollow bug: it required EXACTLY one added or
    // removed uid, so any no-op arrayRemove (removing a uid already absent
    // — happens on a double-tap, a retry, or a desynced followers/following
    // pair) hit neither branch and returned false, rejecting the whole
    // batch — including the caller's own, harmless `following` write,
    // since Firestore batches are all-or-nothing. A correct version must
    // treat "zero added and zero removed" as allowed too, i.e. require
    // each of added/removed to be *either* empty *or* exactly
    // {request.auth.uid} — not reintroduce this until that's verified
    // against the emulator with an actual double-unfollow, not just read
    // through.

    // --------------------------------------------------------------- users --
    match /users/{userId} {
      // Public-ish profile: search, public profile screen, and friends'
      // activity all read other users' docs.
      allow read: if isSignedIn();
      allow create: if isOwner(userId);

      // follow()/unfollow()/block() in SocialService write directly to the
      // *target* user's `followers` array from the client (arrayUnion/
      // arrayRemove), so this can't be a strict isOwner()-only rule.
      //
      // REVERTED 2026-10-04: briefly tightened this with an
      // isSelfOnlyArrayToggle() diff check (any signed-in user could modify
      // only the `followers` field, and only by adding/removing their own
      // uid). That shipped a live bug — unfollow() batches two writes (this
      // doc's `followers` + the caller's own `following`) and Firestore
      // batches are all-or-nothing, so if the tightened rule rejected the
      // `followers` write for any reason, the caller's own `following`
      // write silently rolled back too, making Unfollow appear to
      // instantly re-follow. Root cause in the rule logic itself wasn't
      // confirmed before revert — re-attempt only after verifying against
      // the Firestore emulator (follow, then unfollow, as the actual
      // client-SDK batch, not just reasoning about the rule in isolation).
      // Until then this is back to the original, permissive gap: any
      // signed-in user can modify just the `followers` field of any user
      // doc without a same-uid check (low-severity — see plan.md).
      allow update: if isOwner(userId) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));
      // Lets SettingsScreen's account-deletion flow remove the profile doc.
      // Subcollections aren't cascade-deleted by this (Firestore doesn't do
      // that), so they're orphaned rather than purged — a full wipe needs a
      // Cloud Function with the Admin SDK.
      allow delete: if isOwner(userId);

      // Private per-user movie/show library. Read is opened up because
      // SocialService.userWatchedMovies/userFavoriteMovies/userShows read
      // another user's subcollection directly (public profile screen).
      match /movies/{movieId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /shows/{showId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);

        // Per-episode watched flags and private notes — never read
        // cross-user in the app, so owner-only both ways.
        match /watched/{episodeKey} {
          allow read, write: if isOwner(userId);
        }
        match /notes/{episodeKey} {
          allow read, write: if isOwner(userId);
        }
      }

      // Watch-history timeline. Read is public-to-signed-in because
      // SocialService.friendsActivity() reads followed users' activity.
      match /activity/{activityId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // Diary entries are private — never read cross-user.
      match /diary/{entryId} {
        allow read, write: if isOwner(userId);
      }
      // Custom lists are private by default; the owner can flip `public`
      // (ListService.setPublic) to let any signed-in user read (not write)
      // one specific list — used for the public-profile "Lists" rail and
      // for following someone else's list. Writing always stays owner-only.
      match /lists/{listId} {
        allow read: if isOwner(userId) ||
          (isSignedIn() && resource.data.get('public', false) == true);
        allow write: if isOwner(userId);
      }
      // A user's own record of which (other users') lists they follow —
      // fully self-owned, no cross-user access needed at all.
      match /followedLists/{refId} {
        allow read, write: if isOwner(userId);
      }

      // This user's own answers to the post-watch "how was it?" poll —
      // never read cross-user (the aggregate in /polls covers that).
      match /pollAnswers/{pollId} {
        allow read, write: if isOwner(userId);
      }

      // Daily guessing-game progress (DailyGameService), one doc per day
      // played (`yyyy-mm-dd`) — private, same reasoning as diary entries.
      match /gamePlays/{dateKey} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------- gameConfig --
    // Daily guessing-game movie pool (DailyGameService) — world-readable
    // (every signed-in user needs it to compute today's puzzle), written only
    // by the one-off seed script via the Admin SDK (bypasses these rules
    // entirely), never by the client.
    match /gameConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------- polls --
    // Cross-user aggregate counts for the post-watch poll (PollService).
    // Anyone signed in can read (to show live percentages) and increment the
    // count/total fields (to cast a vote) — same manipulation caveat as the
    // `followers` field above: any signed-in user could inflate these for-fun
    // stats, which is an acceptable, low-severity tradeoff for this app.
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ratingCounts', 'ratingTotal',
          'platformCounts', 'platformTotal',
          'emotionCounts', 'emotionTotal',
          'characterCounts', 'characterTotal',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // --------------------------------------------------------- watchPolls --
    // "What should we watch?" group polls (WatchPollService) — scoped to
    // the poll's own member list, unlike /polls above which is world-
    // readable. Only members can read; the creator can change anything
    // (title, status, delete); any other member may only touch `options`
    // (their vote) + `updatedAt` — same "trusts the client not to touch
    // someone else's entry" caveat as `followers`/`polls` above.
    match /watchPolls/{pollId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        (request.auth.uid in resource.data.memberUids &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'updatedAt']))
      );
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;
    }

    // ------------------------------------------------------------ comments --
    // Public UGC on titles (CommentService). Anyone signed in can read and
    // post; only the author can delete; likes are the one field anyone
    // signed in may toggle on someone else's comment.
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // REVERTED 2026-10-04 along with `followers` above — same
      // isSelfOnlyArrayToggle() guard, reverted as a precaution even though
      // only the unfollow bug was confirmed, since both used the identical
      // function. Re-attempt only after emulator verification.
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------- reports --
    // Moderation reports (CommentService.report()). Write-only from the
    // client; reviewing them is a moderator/admin-console job (the Admin
    // SDK bypasses these rules), so there is no client-facing read case.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
